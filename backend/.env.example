# MeshVault Backend — Required Environment Variables
# Copy this to .env and fill in your actual values

# PostgreSQL connection string (REQUIRED)
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/meshvault

# Secret key for auth token security (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Comma-separated list of allowed CORS origins (REQUIRED for production)
# Example: https://meshvault.vercel.app,https://www.meshvault.com
ALLOWED_ORIGINS=https://your-frontend-url.vercel.app

# Groq API Key (optional — for LLM / AI features)
GROQ_API_KEY=
